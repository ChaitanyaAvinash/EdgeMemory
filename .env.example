# Copy to .env and fill in. Never commit .env.

# Groq API key: primary LLM (openai/gpt-oss-120b). Synthetic data only.
GROQ_API_KEY=""

# Gemini API key: fallback models (free tier; synthetic data only, see CLAUDE.md data rule).
GEMINI_API_KEY=""

# Hindsight Cloud (https://docs.hindsight.vectorize.io/api-integration/).
HINDSIGHT_API_KEY=""
HINDSIGHT_BASE_URL="https://api.hindsight.vectorize.io"

# Optional: SQLite ledger path (default data/edgememory.db).
# EDGEMEMORY_DB="data/edgememory.db"
