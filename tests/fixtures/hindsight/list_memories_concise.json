    {
      "id": "43a07082-1ae2-4605-8f63-4d2b9408a335",
      "text": "When a bank change coincides with a line-down budget overrun, the standard procurement process is overridden to allow immediate PO release (EXPEDITE_PO) while holding payment (HOLD_PAYMENT) until bank callback (VERIFY_BANK_CALLBACK) and controller sign-off (ADD_CONTROLLER_SIGNOFF) are completed, supported by line-down evidence (ATTACH_LINE_DOWN_EVIDENCE) and an allowed budget variance (ALLOW_BUDGET_OVERRUN). This procedure was applied in case PR-2026-0312.",
      "context": "",
      "date": "2026-03-11T06:30:00+00:00",
      "fact_type": "observation",
      "mentioned_at": "2026-03-11T06:30:00.040000+00:00",
      "occurred_start": "2026-03-11T06:30:00+00:00",
      "occurred_end": "2026-03-12T18:29:59.030000+00:00",
      "entities": "",
      "proof_count": 1,
      "tags": [
